# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Auto-generated KB artifacts (재생성 가능 — design/scripts/nf-manifest.py, design/scripts/nf-status.py)
design/*/_manifest.yaml
design/*/_contract_status.yaml

# /nf-init seed (재생성 가능 — design/scripts/nf-seed-gen.py)
design/*/_contract_seed.yaml

# arch/impl status (재생성 가능 — design/scripts/nf-arch-status.py, design/scripts/nf-impl-status.py)
design/*/_arch_status.yaml
dev/*/_impl_status.yaml
# engineering design freeze status (재생성 가능 — design/scripts/nf-eng-status.py)
engineering/*/_engineering_status.yaml

# /nf-build 산출 (재생성 가능 — design/scripts/build-handoff.py + nf-build SKILL)
design/*/contract/
handoff/*/contract.yaml

# spec docx split cache (재생성 가능 — design/scripts/spec-split.py)
specs/*/_extracted/

# Reset archive (git history 가 이미 진실 출처)
design/*/_archive/

# Obsidian (per-user state, plugin cache)
.obsidian/workspace
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# OMX runtime
.omx/*

# npx skills (외부 skill 설치 산출 — repo 공유 대상 아님)
.agents/
skills-lock.json
# .claude/skills/<name> 은 .agents/ 본문으로의 symlink — 본 repo 추적 대상 아님.
# 본 repo 의 native skill (nf-*) 은 이미 tracked 라 본 패턴 영향 없음.
.claude/skills/caveman
.claude/skills/diagnose
.claude/skills/docx
.claude/skills/grill-me
.claude/skills/grill-with-docs
.claude/skills/handoff
.claude/skills/improve-codebase-architecture
.claude/skills/pdf
.claude/skills/pptx
.claude/skills/prototype
.claude/skills/setup-matt-pocock-skills
.claude/skills/tdd
.claude/skills/to-issues
.claude/skills/to-prd
.claude/skills/triage
.claude/skills/write-a-skill
.claude/skills/xlsx
.claude/skills/zoom-out

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Temp extraction artifacts
/tmp_*.docx

# WSL/Windows Explorer metadata
*:Zone.Identifier
